<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="new_prod_feedback_form_view" model="ir.ui.view">
    <field name="name">new_prod.feedback.form</field>
    <field name="model">new_prod.feedback</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1>
              <field name="name"/>
            </h1>
          </div>

          <group>
            <group string="General Information" col="2">
              <field name="product_id" placeholder="Select a product..."/>
              <field name="date"/>
            </group>

            <group string="Your Feedback" col="2">
              <field name="rating"/>
              <field name="comment" placeholder="Write your thoughts about the product..."/>
            </group>

            <group string="Upload Photo (Optional)">
              <field name="image" filename="image_filename" widget="image" class="oe_avatar"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="new_prod_feedback_tree_view" model="ir.ui.view">
    <field name="name">new_prod.feedback.tree</field>
    <field name="model">new_prod.feedback</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="rating"/>
        <field name="product_id"/>
        <field name="comment"/>
        <field name="date"/>
      </list>
    </field>
  </record>


  <record id="new_prod_feedback_act_window" model="ir.actions.act_window">
    <field name="name">New Product Feedback</field>
    <field name="res_model">new_prod.feedback</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_create">
        There is no product feedback click here to add a new product feedback
      </p>
    </field>
  </record>

  <record id="product_template_form_view_inherit_feedback" model="ir.ui.view">
    <field name="name">product.template.feedback.inherit</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Feedback">
          <field name="feedback_ids">
            <list editable="bottom">
              <field name="name"/>
              <field name="rating"/>
              <field name="comment"/>
              <field name="date"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

</odoo>